# ==============================================================================
# OrionAlerts Environment Variables
# ==============================================================================

# Public Site Origin
NEXT_PUBLIC_SITE_URL=https://orionalerts.com

# ------------------------------------------------------------------------------
# SMTP Configuration (cPanel Mail / standard SMTP)
# ------------------------------------------------------------------------------
# In cPanel:
# 1. Create email accounts: websitelead@orionalerts.com and partner@orionalerts.com
# 2. Under Email Accounts -> Connect Devices, copy Outgoing Mail Server credentials.
#    Typically:
#    - SMTP Server / Host: mail.orionalerts.com (or server hostname)
#    - SMTP Port: 465 (SSL) or 587 (TLS)
#    - Username: websitelead@orionalerts.com
#    - Password: the mailbox password you set in cPanel
SMTP_HOST=mail.orionalerts.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=websitelead@orionalerts.com
SMTP_PASS=your_mailbox_password_here
SMTP_FROM="OrionAlerts" <websitelead@orionalerts.com>
# Set to false to avoid certificate rejection on shared cPanel SSL hosts
SMTP_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# Lead Routing Recipients
# ------------------------------------------------------------------------------
# Standard contact forms & demo requests:
WEBSITE_LEAD_EMAIL=websitelead@orionalerts.com

# Partnership inquiries (topic=partner):
PARTNER_EMAIL=partner@orionalerts.com

# ------------------------------------------------------------------------------
# Admin & Blog CMS
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=change-me-to-a-strong-secret
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ------------------------------------------------------------------------------
# Google reCAPTCHA v2 (checkbox) — required for the Book a Demo form
# ------------------------------------------------------------------------------
# Site key (public). Set EITHER of these:
#   RECAPTCHA_SITE_KEY             read by the server at request time (served to the
#                                  form via /api/recaptcha-config). Set it as a runtime
#                                  variable (Cloudflare Worker variable, cPanel env);
#                                  no rebuild needed. Takes precedence.
#   NEXT_PUBLIC_RECAPTCHA_SITE_KEY build-time variable, inlined into the client
#                                  bundle as a fallback. Also read at runtime when it
#                                  was not set during the build.
RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key (server-only, runtime). Must belong to the same key pair as the site key.
RECAPTCHA_SECRET_KEY=
