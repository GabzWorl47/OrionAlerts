# Admin page (/admin) — required to sign in
ADMIN_PASSWORD=change-me

# LinkedIn auto-fetch for /blogs (company page posts)
# 1) Create an app at https://www.linkedin.com/developers/apps
# 2) Request Community Management / r_organization_social access
# 3) Generate a member access token that can read your company page posts
# 4) Find your organization ID (numeric) from the company page admin URL or Organizations API
#
# When these are missing, the "From LinkedIn" section stays hidden.
# You can still use /admin to check status and prepare for later integration.
# Visibility choices are stored in data/linkedin-visibility.json (new posts hidden by default).

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_PAGE_URL=https://www.linkedin.com/company/your-company
# Optional pin, format YYYYMM (LinkedIn requires a current monthly version)
LINKEDIN_API_VERSION=202605
